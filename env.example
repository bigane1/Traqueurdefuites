# Copier en .env.local (dev) ou variables Vercel (Project → Settings → Environment Variables)

# URL publique — remplacer par l’URL *.vercel.app après le 1er déploiement
NEXT_PUBLIC_SITE_URL=https://votre-projet.vercel.app

# Admin /admin (optionnel pour la démo)
ADMIN_PASSWORD=

# Formulaire contact (optionnel pour la maquette)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TO=contact@traqueurdefuites.fr

# PostgreSQL (optionnel — la maquette fonctionne sans)
DATABASE_URL=
